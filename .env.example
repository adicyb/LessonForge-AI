# LessonForge AI Environment Configuration

# Primary LLM Provider: "gemini", "openai", or "fallback"
LLM_PROVIDER=gemini

# API Credentials (Optional - system gracefully switches to high-fidelity fallback when absent)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage Configuration
DATABASE_PATH=data/lessons.db

# Operational Constraints
MAX_LESSON_DURATION_MINUTES=45
DEFAULT_LESSON_DURATION_MINUTES=45

# Fallback Mode: "auto" (activates fallback if keys are missing or invalid) or "force"
FALLBACK_MODE=auto

# Logging Level: "DEBUG", "INFO", "WARNING", "ERROR"
LOG_LEVEL=INFO
